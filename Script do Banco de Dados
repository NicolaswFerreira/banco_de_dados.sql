-- Questão 1: Listar nome, vencimento e valor de cada duplicata da tabela.
SELECT Nome, Vencimento, Valor FROM duplicata;

-- Questão 2: Apresentar o número das duplicatas depositadas no banco Itaú.
SELECT Numero FROM duplicata WHERE Banco = 'ITAU';

-- Questão 3: Quais são as duplicatas (número, vencimento, valor e nome) que vencem no ano de 2017.
SELECT Numero, Vencimento, Valor, Nome FROM duplicata WHERE YEAR(Vencimento) = 2017;

-- Questão 4: Apresentar as duplicatas (número, vencimento, valor e nome) que não estão depositadas nos bancos Itaú e Santander.
SELECT Numero, Vencimento, Valor, Nome FROM duplicata WHERE Banco NOT IN ('ITAU', 'SANTANDER');

-- Questão 5: Quanto é o valor da dívida do cliente PAPELARIA SILVA, e quais são as duplicatas?
SELECT Numero, Valor FROM duplicata WHERE Nome = 'PAPELARIA SILVA';
SELECT SUM(Valor) AS Valor_Total_Divida FROM duplicata WHERE Nome = 'PAPELARIA SILVA';

-- Questão 6: Retirar da tabela a duplicata 770710 do cliente LIVRARIA FERNANDES, por ter sido devidamente quitada.
DELETE FROM duplicata WHERE Numero = 770710;

-- Questão 7: Apresentar uma listagem em ordem alfabética por nome do cliente de todos os campos da tabela.
SELECT * FROM duplicata ORDER BY Nome ASC;

-- Questão 8: Apresentar uma listagem em ordem de data de vencimento com o nome do cliente, banco, valor e vencimento.
SELECT Nome, Banco, Valor, Vencimento FROM duplicata ORDER BY Vencimento ASC;
